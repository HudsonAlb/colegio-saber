# URL pública do site, sem barra no final. Usada em canonical, Open Graph, JSON-LD, sitemap e robots.txt.
# Domínio oficial da escola (colegiosaberpe.com.br redireciona para o www). Também pode ser sobrescrito pela variável VITE_SITE_URL da Vercel.
VITE_SITE_URL=https://www.colegiosaberpe.com.br

# URL (termina em /exec) do Web App que grava o formulário de matrícula na planilha Google.
# Como criar: instruções no topo de scripts/matriculas-google-sheets.gs. Sem ela, o formulário mostra erro e pede para ligar na secretaria.
VITE_MATRICULA_SHEET_URL=https://script.google.com/macros/s/AKfycbyvdr2V_X8i9SJVSNBKacRx4AijfYazhoBO3-OpPYaW341Woh7oB5SuYwVEXsj3dAoTPQ/exec
